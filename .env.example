# Neon Postgres connection string (pooled endpoint, sslmode=require)
DATABASE_URL=

# VAPID keys for Web Push. Generate ONCE with:
#   npx web-push generate-vapid-keys --json
# The private key must never be exposed to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for the push service, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Public origin of the deployment. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000